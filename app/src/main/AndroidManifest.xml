<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Phone and SMS permissions -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Camera and storage permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" android:minSdkVersion="33" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" android:minSdkVersion="33" />

    <!-- Notification and vibration -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Foreground service for live tracking -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
        <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Hardware features -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name="com.example.kwaaimancarservices.KwaaimanApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/kwaaiman_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/kwaaiman_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.KwaaimanCarServices"
        tools:targetApi="31">

        <!-- Main Activity (Launcher) -->
        <activity
            android:name="com.example.kwaaimancarservices.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.KwaaimanCarServices"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding Activity -->
        <activity
            android:name="com.example.kwaaimancarservices.activities.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.KwaaimanCarServices.Onboarding"
            android:screenOrientation="unspecified" />

        <!-- Authentication Activity -->
        <activity
            android:name="com.example.kwaaimancarservices.activities.AuthActivity"
            android:exported="false"
            android:theme="@style/Theme.KwaaimanCarServices.Auth"
            android:screenOrientation="unspecified" />



        <!-- Profile Activity -->
        <activity
            android:name="com.example.kwaaimancarservices.activities.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.KwaaimanCarServices" />

        <!-- Trip History Activity -->
        <activity
            android:name="com.example.kwaaimancarservices.activities.TripHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.KwaaimanCarServices" />

        <!-- Payment Methods Activity -->
        <activity
            android:name="com.example.kwaaimancarservices.activities.PaymentMethodsActivity"
            android:exported="false"
            android:theme="@style/Theme.KwaaimanCarServices" />

        <!-- Settings Activity -->
        <activity
            android:name="com.example.kwaaimancarservices.activities.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.KwaaimanCarServices" />

        <!-- Driver Dashboard Activity -->
        <activity
            android:name="com.example.kwaaimancarservices.activities.DriverDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.KwaaimanCarServices" />

        <!-- Location Search Activity -->
        <activity
            android:name="com.example.kwaaimancarservices.activities.LocationSearchActivity"
            android:exported="false"
            android:theme="@style/Theme.KwaaimanCarServices"
            android:windowSoftInputMode="adjustResize" />

        <!-- Ride Booking Activity -->
        <activity
            android:name="com.example.kwaaimancarservices.activities.RideBookingActivity"
            android:exported="false"
            android:theme="@style/Theme.KwaaimanCarServices" />

        <!-- Trip Tracking Activity -->
        <activity
            android:name="com.example.kwaaimancarservices.activities.TripTrackingActivity"
            android:exported="false"
            android:theme="@style/Theme.KwaaimanCarServices" />

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyBfxKKGkrftRvCLtRme_IFb0I6tYRq6xvw" />

        <!-- Firebase Cloud Messaging Service -->
        <service
            android:name="com.example.kwaaimancarservices.services.FirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Location Tracking Service -->
        <service
            android:name="com.example.kwaaimancarservices.services.LocationTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Driver Matching Service -->
        <service
            android:name="com.example.kwaaimancarservices.services.DriverMatchingService"
            android:exported="false" />

        <!-- Security Service -->
        <service
            android:name="com.example.kwaaimancarservices.services.SecurityService"
            android:exported="false" />

    </application>

</manifest>