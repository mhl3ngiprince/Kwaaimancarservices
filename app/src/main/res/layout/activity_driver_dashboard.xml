<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".activities.DriverDashboardActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/driver_dashboard_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Statistics Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/today_earnings"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/today_earnings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/zero_currency"
            android:textSize="20sp"
            android:textColor="@color/gold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/weekly_earnings"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/weekly_earnings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/zero_currency"
            android:textSize="20sp"
            android:textColor="@color/gold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/monthly_earnings"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/monthly_earnings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/zero_currency"
            android:textSize="20sp"
            android:textColor="@color/gold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/total_rides"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/total_rides"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/zero_value"
            android:textSize="20sp"
            android:textColor="@color/gold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/driver_rating"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/driver_rating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/zero_rating"
            android:textSize="20sp"
            android:textColor="@color/gold" />

    </LinearLayout>

</LinearLayout>